{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.compat.tsbuildinfo",
    "target": "ES2015",
    "lib": ["ES5", "DOM"],
    "module": "ESNext",
    "moduleDetection": "legacy",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "noEmit": true
  },
  "include": ["compat/**/*.ts"]
}
