{
  "name": "music-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --manifest && node scripts/check-entry-bundle.mts",
    "preview": "vite preview",
    "typecheck": "tsc -b ../tsconfig.json --noEmit",
    "lint": "npm run check:source && cd .. && oxlint --config .oxlintrc.json --report-unused-disable-directives --deny-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:source": "node scripts/check-source.mts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "acorn": "^8.18.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
