# Copy to .env at the repository root. Every value below has a safe development default.

# SQLite application database. Rust accepts only a file-backed sqlite:/// URL.
DATABASE_URL=sqlite:///./app.db

# Media and authored-content roots.
MUSIC_DIR=./music
SFX_LIBRARY_DIR=./sfx
MODES_DIR=./modes

# Optional read-only seed copied only when MODES_DIR is empty.
# MODES_SEED_DIR=/path/to/read-only/mode-seed

# Legacy remembered-device JSON is a bounded, one-time migration input. Rust stores
# remembered devices in SQLite and never writes this file.
DEVICES_FILE=./devices.json

# Canonical server-side end-of-track advancement.
ADVANCER_ENABLED=true

# Split-development CORS and session-cookie settings.
ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_NAME=music_session
# SESSION_TTL_DAYS=30

# Optional Assistant provider credential encryption. Use exactly one source;
# the environment value takes precedence. Never commit either value or file.
# ASSISTANT_CREDENTIAL_KEY=
# ASSISTANT_CREDENTIAL_KEY_FILE=/absolute/path/to/assistant-credential.key
# ASSISTANT_CREDENTIAL_HOST_DIRECTORY_HINT=/srv/music-secrets

# Optional local voice/instrumental classifier. The model must be the exact
# supported checksum and is never downloaded or bundled by the application.
# ASSISTANT_VOICE_MODEL_PATH=/absolute/path/to/voice_instrumental-musicnn-msd-2.pb

# Bounded first-pass context-analysis concurrency. Voice inference remains a
# separate capacity-one model-owning Rust worker.
# ASSISTANT_LIBRARY_CONTEXT_WORKERS=1

# Per-request upload guard rails.
# MAX_UPLOAD_FILES=500
# MAX_UPLOAD_FILE_BYTES=1073741824

LOG_LEVEL=info

# Built SPA served at /. Empty means API-only development; the release image
# sets /app/static.
STATIC_DIR=
