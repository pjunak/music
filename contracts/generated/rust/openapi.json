{
  "components": {
    "schemas": {
      "ActiveSessionResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "is_current": {
            "type": "boolean"
          },
          "last_seen": {
            "format": "date-time",
            "type": "string"
          },
          "token_prefix": {
            "type": "string"
          }
        },
        "required": [
          "token_prefix",
          "created_at",
          "expires_at",
          "last_seen",
          "is_current"
        ],
        "type": "object"
      },
      "AmbientState": {
        "properties": {
          "current_track_id": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "history": {
            "default": [],
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "loop": {
            "default": "off",
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoopMode"
              }
            ]
          },
          "position_anchored_at": {
            "default": null,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "position_ms": {
            "default": 0,
            "format": "int64",
            "type": "integer"
          },
          "queue": {
            "default": [],
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "shuffle": {
            "default": "off",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ShuffleMode"
              }
            ]
          },
          "source_playlist_id": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ComponentStatus": {
        "enum": [
          "starting",
          "ready",
          "degraded",
          "failed"
        ],
        "type": "string"
      },
      "CrossfadeType": {
        "enum": [
          "linear",
          "equal_power",
          "cut"
        ],
        "type": "string"
      },
      "DeviceInfo": {
        "properties": {
          "client_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "is_output": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "client_id",
          "name"
        ],
        "type": "object"
      },
      "DeviceOut": {
        "properties": {
          "added_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "client_id": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "is_output": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "name",
          "is_output",
          "connected"
        ],
        "type": "object"
      },
      "DevicePut": {
        "properties": {
          "is_output": {
            "default": false,
            "type": "boolean"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "FolderOut": {
        "properties": {
          "has_children": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "track_count": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "path",
          "track_count",
          "has_children"
        ],
        "type": "object"
      },
      "FoldersResponse": {
        "properties": {
          "folders": {
            "items": {
              "$ref": "#/components/schemas/FolderOut"
            },
            "type": "array"
          }
        },
        "required": [
          "folders"
        ],
        "type": "object"
      },
      "HTTPValidationError": {
        "description": "FastAPI-compatible validation envelope retained as a stable HTTP contract.",
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "InterruptState": {
        "properties": {
          "current_track_id": {
            "format": "int64",
            "type": "integer"
          },
          "duck_to": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "fade_in_ms": {
            "format": "int64",
            "type": "integer"
          },
          "fade_out_ms": {
            "format": "int64",
            "type": "integer"
          },
          "position_anchored_at": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "position_ms": {
            "format": "int64",
            "type": "integer"
          },
          "queue": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "return_to_ambient": {
            "type": "boolean"
          }
        },
        "required": [
          "current_track_id"
        ],
        "type": "object"
      },
      "LivenessContract": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "LoopMode": {
        "enum": [
          "off",
          "follow",
          "queue",
          "track"
        ],
        "type": "string"
      },
      "LoopingSfx": {
        "properties": {
          "id": {
            "type": "string"
          },
          "interval_s": {
            "format": "double",
            "type": "number"
          },
          "item_path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "soundboard_id": {
            "type": "string"
          },
          "volume": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "soundboard_id",
          "item_path",
          "interval_s"
        ],
        "type": "object"
      },
      "PlayerState": {
        "properties": {
          "active_mode_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "active_output_device_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "active_preset_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "active_soundboard_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "ambient": {
            "default": {
              "current_track_id": null,
              "history": [],
              "loop": "off",
              "position_anchored_at": null,
              "position_ms": 0,
              "queue": [],
              "shuffle": "off",
              "source_playlist_id": null
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/AmbientState"
              }
            ]
          },
          "connected_devices": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/DeviceInfo"
            },
            "type": "array"
          },
          "crossfade_ms": {
            "default": 0,
            "format": "int64",
            "type": "integer"
          },
          "crossfade_type": {
            "default": "linear",
            "oneOf": [
              {
                "$ref": "#/components/schemas/CrossfadeType"
              }
            ]
          },
          "default_device_volume": {
            "default": 1.0,
            "format": "double",
            "type": "number"
          },
          "device_volumes": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "default": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "interrupt": {
            "default": null,
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InterruptState"
              }
            ]
          },
          "is_playing": {
            "default": false,
            "type": "boolean"
          },
          "last_position_report": {
            "default": null,
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PositionReport"
              }
            ]
          },
          "looping_sfx": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/LoopingSfx"
            },
            "type": "array"
          },
          "position_epoch": {
            "default": 0,
            "format": "int64",
            "type": "integer"
          },
          "preset_revision": {
            "default": 0,
            "format": "int64",
            "type": "integer"
          },
          "revision": {
            "default": 0,
            "format": "int64",
            "type": "integer"
          },
          "volume": {
            "default": 1.0,
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "PositionReport": {
        "properties": {
          "device_id": {
            "type": "string"
          },
          "position_ms": {
            "format": "int64",
            "type": "integer"
          },
          "reported_at": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "device_id",
          "position_ms",
          "reported_at"
        ],
        "type": "object"
      },
      "ReadinessSnapshot": {
        "properties": {
          "components": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ComponentStatus"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/ReadinessStatus"
          }
        },
        "required": [
          "status",
          "components"
        ],
        "type": "object"
      },
      "ReadinessStatus": {
        "enum": [
          "starting",
          "ready",
          "degraded",
          "not_ready"
        ],
        "type": "string"
      },
      "RescanResult": {
        "properties": {
          "added": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "removed": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "unchanged": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "updated": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "added",
          "updated",
          "removed",
          "unchanged"
        ],
        "type": "object"
      },
      "SearchOrder": {
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "SearchResponse": {
        "properties": {
          "limit": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "order": {
            "$ref": "#/components/schemas/SearchOrder"
          },
          "sort": {
            "$ref": "#/components/schemas/SearchSort"
          },
          "total": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/TrackOut"
            },
            "type": "array"
          }
        },
        "required": [
          "tracks",
          "total",
          "limit",
          "offset",
          "sort",
          "order"
        ],
        "type": "object"
      },
      "SearchSort": {
        "enum": [
          "title",
          "artist",
          "album",
          "album_artist",
          "year",
          "length_s",
          "track_no",
          "added_at",
          "path"
        ],
        "type": "string"
      },
      "ShuffleMode": {
        "enum": [
          "off",
          "random"
        ],
        "type": "string"
      },
      "TrackOut": {
        "properties": {
          "added_at": {
            "type": "string"
          },
          "album": {
            "type": "string"
          },
          "album_artist": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "bpm": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "disc_no": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "display_title": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "length_s": {
            "format": "double",
            "type": "number"
          },
          "origin": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "size_bytes": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "track_no": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "year": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "title",
          "artist",
          "album_artist",
          "album",
          "genre",
          "length_s",
          "size_bytes",
          "added_at",
          "display_title",
          "origin"
        ],
        "type": "object"
      },
      "TreeResponse": {
        "properties": {
          "path": {
            "type": "string"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/TrackOut"
            },
            "type": "array"
          }
        },
        "required": [
          "path",
          "tracks"
        ],
        "type": "object"
      },
      "UserInfoResponse": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "type": "object"
          },
          "input": {},
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array"
          },
          "msg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Music contributors"
    },
    "description": "",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "music-server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/sessions": {
      "get": {
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ActiveSessionResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/sessions/{token_prefix}": {
      "delete": {
        "operationId": "revoke_session",
        "parameters": [
          {
            "description": "Unique session token prefix",
            "in": "path",
            "name": "token_prefix",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/devices": {
      "get": {
        "operationId": "list_devices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceOut"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "tags": [
          "devices"
        ]
      }
    },
    "/api/devices/{client_id}": {
      "delete": {
        "operationId": "forget_device",
        "parameters": [
          {
            "description": "Stable client identity",
            "in": "path",
            "name": "client_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "tags": [
          "devices"
        ]
      },
      "put": {
        "operationId": "save_device",
        "parameters": [
          {
            "description": "Stable client identity",
            "in": "path",
            "name": "client_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicePut"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "tags": [
          "devices"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessContract"
                }
              }
            },
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/library/folders": {
      "get": {
        "operationId": "folders",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoldersResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "tags": [
          "library"
        ]
      }
    },
    "/api/library/rescan": {
      "post": {
        "operationId": "rescan",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RescanResult"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "tags": [
          "library"
        ]
      }
    },
    "/api/library/search": {
      "get": {
        "operationId": "search",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SearchSort"
            }
          },
          {
