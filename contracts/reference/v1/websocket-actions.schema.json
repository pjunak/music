    "StartLoopAction": {
      "description": "Start a repeating SFX. A server-side timer fires it every `interval_s`\nuntil `stop_loop`. `id` is a client-minted handle (so the same client can\nstop it). Lives in PlayerState so every LOOPS panel sees it.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "interval_s": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Interval S",
          "type": "number"
