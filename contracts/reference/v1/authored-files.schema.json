{
  "cue": {
    "$defs": {
      "CueLoop": {
        "description": "A repeating SFX a cue starts (added to the live LOOPS panel).",
        "properties": {
          "interval_s": {
            "maximum": 3600,
            "minimum": 1,
            "title": "Interval S",
            "type": "number"
          },
          "item": {
            "title": "Item",
            "type": "string"
          },
          "soundboard": {
            "title": "Soundboard",
            "type": "string"
          },
          "volume": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Volume",
            "type": "number"
          }
        },
        "required": [
          "soundboard",
          "item",
          "interval_s"
        ],
        "title": "CueLoop",
        "type": "object"
      },
      "CueSfx": {
        "description": "A one-shot SFX a cue fires when it runs.",
        "properties": {
          "item": {
            "title": "Item",
            "type": "string"
          },
          "soundboard": {
            "title": "Soundboard",
            "type": "string"
          },
          "volume": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Volume",
            "type": "number"
          }
        },
        "required": [
          "soundboard",
          "item"
        ],
        "title": "CueSfx",
        "type": "object"
      }
    },
    "description": "A saved one-click setup. Firing it applies a preset, starts a playlist\n(from a given song + timestamp), fires one-shot SFX, and starts loops.\nEverything references existing pieces by name; all parts are optional.",
    "properties": {
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Description"
      },
      "id": {
        "title": "Id",
        "type": "string"
      },
      "loops": {
        "items": {
          "$ref": "#/$defs/CueLoop"
        },
        "title": "Loops",
        "type": "array"
      },
      "name": {
        "title": "Name",
        "type": "string"
      },
      "playlist": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Playlist"
      },
      "preset": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Preset"
      },
      "sfx": {
        "items": {
          "$ref": "#/$defs/CueSfx"
        },
        "title": "Sfx",
        "type": "array"
      },
      "start_index": {
        "default": 0,
        "minimum": 0,
        "title": "Start Index",
        "type": "integer"
      },
      "start_ms": {
        "default": 0,
        "minimum": 0,
        "title": "Start Ms",
        "type": "integer"
      }
    },
    "required": [
      "id",
      "name"
    ],
    "title": "CueSpec",
    "type": "object"
  },
