# The release image needs only these build inputs. This allowlist keeps local
# tools, runtime state, generated output, and unrelated workspace files out of
# the Docker build context.
**

!Cargo.toml
!Cargo.lock
!rust-toolchain.toml

!crates/
!crates/**

!frontend/
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.app.json
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/public/
!frontend/public/**
!frontend/scripts/
!frontend/scripts/**
!frontend/src/
!frontend/src/**

!modes/
!modes/**
modes/*/cache/
modes/*/cache/**

!docs/
!docs/THIRD_PARTY_NOTICES.md
