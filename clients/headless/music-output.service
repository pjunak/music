# systemd unit for the headless output. Install to /etc/systemd/system/,
# adjust paths to where you installed the Rust binary, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now music-output
#
# Config lives in /etc/music-output.env (see below), so the unit itself is host-agnostic.
[Unit]
Description=Music headless audio output
# Wait for the network and the sound stack before starting — otherwise the
# first connect/playback attempt races boot and fails until the Restart kicks in.
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=audio
StateDirectory=music-output
StateDirectoryMode=0700
Environment=HOME=/var/lib/music-output
Environment=MUSIC_STATE_DIR=/var/lib/music-output
# An env file keeps the server URL / name / control port out of the unit:
#   MUSIC_SERVER_URL=http://192.168.1.50:8000
#   MUSIC_OUTPUT_NAME=Living-room speaker
#   MUSIC_CONTROL_PORT=8731
EnvironmentFile=/etc/music-output.env
ExecStart=/opt/music-output/music-output
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
