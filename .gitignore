# Remembered-devices registry (runtime state, lives in the data volume)
devices.json
.devices.json.tmp

# Media / runtime content (never commit user music or uploaded files).
# Anchored so we don't shadow code dirs like backend/app/library/. The
# backend/ pair covers the dev defaults (MUSIC_DIR=./music run from backend/).
/music/
/sfx/
/backend/music/
/backend/sfx/
modes/*/cache/

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage/

# Frontend cache
.eslintcache
*.tsbuildinfo

# Local AI-tool state; shared project guidance lives in tracked AGENTS.md.
.aider*
.cursor/
.continue/
.copilot/
.windsurf/
.codeium/

# Local planning and mockups stay private; architecture decisions are shared.
docs/*
!docs/ADR-*.md
!docs/assistant-ux-philosophy.md
!docs/README.md
!docs/ASSISTANT_ARCHITECTURE.md
!docs/RUST_REWRITE_ARCHITECTURE.md
